import random


def bubble_sort(arr: list[int]) -> list[int]:
    """Сортировка списка пузырьком."""
    result = arr.copy()
    n: int = len(result)
    for i in range(n - 1):
        for j in range(n - 1 - i):
            if result[j] > result[j + 1]:
                result[j], result[j + 1] = result[j + 1], result[j]
    return result


if __name__ == "__main__":
    arr: list[int] = [random.randint(1, 99) for _ in range(8)]
    print("Массив до сортировки:", arr)
    print("Массив после сортировки:", bubble_sort(arr))
