DIARY_FILE: str = "diary.txt"


def add_entry(date_str: str, note: str) -> None:
    with open(DIARY_FILE, "a", encoding="utf-8") as f:
        f.write(f"{date_str} | {note}\n")


def find_by_date(date_str: str) -> list[str]:
    with open(DIARY_FILE, "r", encoding="utf-8") as f:
        return [line.strip() for line in f if line.startswith(date_str)]


if __name__ == "__main__":
    try:
        add_entry("2026-11-27", "Сдана лабораторная работа по РПМ")
        matches = find_by_date("2026-11-27")
        print("Найдено записей:", len(matches))
        for m in matches:
            print("  -", m)
    except FileNotFoundError:
        print("Ошибка: файл дневника не найден.")
    except PermissionError:
        print("Ошибка: недостаточно прав для доступа к файлу.")
    except OSError as e:
        print(f"Системная ошибка ввода-вывода: {e}")
